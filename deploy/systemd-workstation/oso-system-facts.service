[Unit]
Description=OsO Sync — refresh workstation system-facts.md for the responder
Documentation=https://github.com/Matswm86/oso-sync

[Service]
Type=oneshot
# Point ExecStart at your clone and set VPS / MEMORY_SRC in a drop-in (see README).
ExecStart=%h/oso-sync/deploy/generate-system-facts.sh
TimeoutStartSec=120
Nice=19
