[Unit]
Description=OsO Sync — push markdown notes to VPS responder context
Documentation=https://github.com/Matswm86/oso-sync

[Service]
Type=oneshot
# Point ExecStart at your clone and set VPS / MEMORY_SRC in a drop-in (see README).
ExecStart=%h/oso-sync/deploy/sync-memory-to-vps.sh
TimeoutStartSec=300
Nice=19
